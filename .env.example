# Telegram Notifications
# Dapatkan BOT_TOKEN dari @BotFather di Telegram
# Dapatkan CHAT_ID dengan kirim pesan ke bot lalu cek: api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# OPTIONAL: Disable SSL certificate verification untuk Telegram API
# Gunakan HANYA jika ada SSL certificate error dan update certifi tidak berhasil
# false (default) = verify SSL certificates
# true = disable verification (LESS SECURE, gunakan untuk troubleshooting saja)
TELEGRAM_DISABLE_SSL_VERIFY=false

# MetaTrader 5 Configuration
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# Trading Configuration
SYMBOL=XAUUSD
CAPITAL=5000
CAPITAL_MODE=small

# Risk Management
MAX_DAILY_LOSS_PERCENT=3.0
MAX_POSITION_SIZE=0.5
MAX_POSITIONS=1

# Trade Cooldown (Minimum detik antara entries)
# Cegah over-trading dengan enforce minimum wait time antar trade
# Value dalam SECONDS:
# - 150 = 2.5 min (aggressive scalping, ~24 trades/hour max)
# - 300 = 5 min (day trading, ~12 trades/hour max)
# - 600 = 10 min (moderate, ~6 trades/hour max)
# - 2700 = 45 min (conservative, ~1-2 trades/hour max)
# - 3600 = 60 min (very conservative, ~1 trade/hour max)
TRADE_COOLDOWN_SECONDS=150

# AI Model
ML_MODEL_PATH=models/xgboost_model.json
AI_CONFIDENCE_THRESHOLD=0.65

# Regime Detection
HMM_LOOKBACK=500
HMM_N_REGIMES=3

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/trading_bot.log

# Startup Warmup
# Bot menunggu N candle M15 setelah startup sebelum mulai trading
# 3 candle = 45 menit warmup (indikator stabil)
STARTUP_WARMUP_LOOPS=3

# Trailing Stop (Position Manager)
# Trail mulai saat profit >= TRAIL_START_USD dollar
# Trail distance dalam pips (1 pip = $0.1 pergerakan harga gold)
# Progressive: makin besar profit, makin ketat trail-nya
TRAIL_START_USD=3.0
TRAIL_DISTANCE_PIPS=15.0

# Database (PostgreSQL)
# Set DB_ENABLED=true and isi kredensial di bawah jika PostgreSQL sudah di-setup
# Set DB_ENABLED=false untuk skip database dan pakai CSV fallback saja
DB_ENABLED=false
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=trading_db
# DB_USER=trading_bot
# DB_PASSWORD=trading_bot_2026

# ============================================================
# AI Market Analyzer (Z.AI / DeepSeek / OpenRouter / OpenAI)
# ============================================================
# Fase 1: Enrichment Telegram notification saja (zero risk)
# LLM menambah narasi makro ke Telegram, tidak mempengaruhi trading decisions

# Provider selection
# Options: zai, deepseek, openrouter, openai, anthropic
# Recommended: zai (glm-4) or deepseek untuk latency rendah & cost murah
AI_PROVIDER=zai

# API Credentials — sesuaikan dengan provider pilihan
# Z.AI:        https://open.bigmodel.cn → sign up, buat API key
# DeepSeek:    https://platform.deepseek.com → buat API key
# OpenRouter:  https://openrouter.ai → sign up untuk akses multiple models
# OpenAI:      https://platform.openai.com → get API key
# Anthropic:   https://console.anthropic.com → get API key
AI_API_KEY=

# Model selection — leave empty untuk default provider
# Z.AI models:       glm-4 (recommended), glm-4-vision, glm-3-turbo
# DeepSeek models:   deepseek-chat (recommended), deepseek-coder
# OpenRouter models: deepseek/deepseek-chat, gpt-4o-mini, etc
# OpenAI models:     gpt-4o-mini (recommended), gpt-3.5-turbo
# Anthropic models:  claude-haiku-4-5-20251001 (default, recommended)
AI_MODEL=

# Enable AI enrichment
# true = aktif (cost ~$0.5-2/hari)
# false = disabled (no cost, no enrichment)
AI_ENABLED=true

# ============================================================
# Lapis 3: AI SL Analysis (Stop Loss Learning)
# ============================================================
# Analisis AI untuk setiap SL: kenapa terjadi, lesson learned
# Dikirim ke Telegram sebagai notifikasi informatif (BUKAN trade decision)

# Enable SL analysis (Lapis 3)
# true = analisis SL + kirim ke Telegram (informatif saja)
# false = skip SL analysis (hemat biaya)
SL_ANALYSIS_ENABLED=true

# OPTIONAL: Gunakan hasil AI analysis untuk influence next trade decision
# THIS REQUIRES EXPLICIT OPT-IN — jangan aktifkan tanpa testing!
#
# false (default) = SL analysis → Telegram notification saja (SAFE, zero impact)
# true = SL analysis → Telegram + confidence_modifier untuk next entry (EXPERIMENTAL)
#
# Penjelasan impact ketika TRUE:
# - Setelah SL dianalisa AI, confidence_modifier disimpan
# - Next trade entry: DynamicConfidenceManager reduce/boost confidence per modifier
# - Contoh: SL karena "weak signal" → confidence_modifier = -0.15
#   → next entry needs 15% lebih tinggi confidence untuk pass filter
#
# HANYA aktifkan setelah:
# 1. SL analysis berjalan 2+ minggu (validasi AI accuracy)
# 2. Telegram analysis terlihat reasonable
# 3. Manual backtest membuktikan modifier meningkatkan win rate
SL_ANALYSIS_IMPACT_ENABLED=false

# ============================================================
# Cost & Performance Reference
# ============================================================
# Z.AI (glm-4):             ~$0.3-0.5 per 1M tokens (termurah)
# DeepSeek (deepseek-chat): ~$0.14 per 1M tokens (sangat murah)
# OpenRouter:               Variable per model (~$0.1-1 per 1M tokens)
# OpenAI (gpt-4o-mini):     ~$0.15 per 1M tokens
# Anthropic (Haiku):        ~$0.80 per 1M tokens
#
# Expected usage: ~96 calls/hari × ~1000 tokens/call = ~96K tokens/hari
# Daily cost estimate (Z.AI): 96K × ($0.3/1M) = ~$0.03/hari (~$1/bulan)
