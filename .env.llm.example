# ============================================================================
# LLM Signal Validator Configuration (.env settings)
# ============================================================================
#
# XAUBot AI - Phase 1-3 Claude LLM Integration with SMC & ML
#
# This file documents all environment variables for LLM signal validation.
# Copy relevant settings to your .env file to configure the LLM validator.
#
# QUICK START:
# Phase 1 (Monitoring): Set LLM_ENABLED=true, all others default
# Phase 2 (Modifiers):  Add LLM_MODIFIER_ENABLED=true
# Phase 3 (Macro):      Add LLM_MACRO_ENABLED=true
#
# ============================================================================

# ─────────────────────────────────────────────────────────────────────────
# PHASE CONTROL (Enable/Disable by Phase)
# ─────────────────────────────────────────────────────────────────────────

# Master enable/disable for entire LLM validator
# true: LLM signal validation active
# false: LLM completely disabled (reverts to SMC+ML only)
# Default: true (Phase 1 by default)
LLM_ENABLED=true

# Phase 1: Monitoring & Caching (Week 1)
# true: Run validation async after every trade (zero impact on trading)
# false: Skip monitoring phase
# Default: true (Phase 1 active)
LLM_MONITORING_ENABLED=true

# Phase 2: Apply Confidence Modifiers (Week 2)
# true: Apply cached LLM modifiers to improve entry quality
# false: Monitoring only, don't apply modifiers yet
# Default: false (Phase 1 is monitoring-only first)
LLM_MODIFIER_ENABLED=false

# Phase 3: Macro-Aware Validation (Week 3)
# true: Add macro sentiment to signal validation
# false: Use pattern-based validation only
# Default: false (Phase 3 only after Phase 2 succeeds)
LLM_MACRO_ENABLED=false

# ─────────────────────────────────────────────────────────────────────────
# INTEGRATION WITH EXISTING SIGNALS
# ─────────────────────────────────────────────────────────────────────────

# Include SMC patterns in LLM validation context
# true: Pass SMC signal details (FVG, OB, BOS, CHoCH) to LLM
# false: Only validate ML signal
# Default: true
LLM_WITH_SMC=true

# Include ML predictions in LLM validation context
# true: Pass ML signal + confidence to LLM
# false: Only validate SMC signal
# Default: true
LLM_WITH_ML=true

# ─────────────────────────────────────────────────────────────────────────
# CACHING STRATEGY (Reduce API Calls)
# ─────────────────────────────────────────────────────────────────────────

# How long to cache validation results (in minutes)
# Same patterns within this window use cached result (no API call)
# Higher = fewer API calls, lower = more up-to-date validations
# Target cache hit rate: 40% after warmup (reduces API costs ~60%)
# Default: 30 minutes
LLM_CACHE_DURATION_MIN=30

# Maximum cache entries before cleanup
# When cache exceeds this size, oldest entries are removed
# Keep reasonable to avoid memory bloat
# Default: 1000 patterns
LLM_CACHE_MAX_ENTRIES=1000

# ─────────────────────────────────────────────────────────────────────────
# CONFIDENCE MODIFIER BOUNDS (Phase 2+)
# ─────────────────────────────────────────────────────────────────────────

# Minimum confidence modifier (penalty for poor setups)
# Range: -0.20 to -0.05 (recommended: -0.15)
# Applied to signals with weak confluence or poor conditions
# Default: -0.15 (15% confidence reduction)
LLM_MODIFIER_MIN=-0.15

# Maximum confidence modifier (boost for strong setups)
# Range: +0.05 to +0.20 (recommended: +0.10)
# Applied to signals with high confluence and alignment
# Default: +0.10 (10% confidence boost)
LLM_MODIFIER_MAX=0.10

# Start ratio for modifier application (Phase 2)
# Percentage of signals to apply modifiers to initially
# 0.10 = apply to 10% of signals (test phase)
# 0.50 = apply to 50% of signals (midway)
# 1.00 = apply to 100% of signals (full deployment)
# Default: 0.10 (conservative start)
LLM_MODIFIER_START_RATIO=0.10

# ─────────────────────────────────────────────────────────────────────────
# VALIDATION THRESHOLDS (Decision Gates for Phase Progression)
# ─────────────────────────────────────────────────────────────────────────

# Minimum LLM validation accuracy to proceed from Phase 1 to Phase 2
# Must-have gate: if LLM accuracy < this, stay in Phase 1
# Range: 0.50 to 0.70 (recommended: 0.60 = better than random)
# Default: 0.60 (60% = signals marked valid win 60% of time)
LLM_ACCURACY_THRESHOLD=0.60

# Minimum modifier effectiveness to keep Phase 2 active
# If modifiers help less than this, revert to Phase 1
# Range: 0.50 to 0.70 (recommended: 0.60)
# Default: 0.60 (modifiers must improve 60%+ of signals)
LLM_EFFECTIVENESS_THRESHOLD=0.60

# Target cache hit rate (informational, not enforced)
# After warmup, expect 40-60% cache hits
# Helps monitor if patterns are forming well
# Default: 0.40 (40% hit rate target)
LLM_CACHE_HIT_RATE_TARGET=0.40

# ─────────────────────────────────────────────────────────────────────────
# API PERFORMANCE & COST CONTROL
# ─────────────────────────────────────────────────────────────────────────

# Timeout for LLM API calls (seconds)
# If LLM takes longer, skip validation and continue trading
# Async validation never blocks trades, but long timeouts waste resources
# Range: 2 to 10 seconds (recommended: 5)
# Default: 5 seconds
LLM_API_TIMEOUT_SEC=5

# Daily cost limit for LLM API calls (USD)
# If daily cost exceeds this, stop calling LLM (fallback to SMC+ML)
# With caching: ~$0.01-0.05/day expected
# With Phase 2: ~$0.05-0.10/day (more calls)
# Default: $1.00 (high limit, usually not hit)
LLM_DAILY_COST_LIMIT=1.0

# ─────────────────────────────────────────────────────────────────────────
# LOGGING & MONITORING
# ─────────────────────────────────────────────────────────────────────────

# Log every LLM validation call and result
# true: Log [LLM VALIDATION] messages for every signal
# false: Only log issues/errors
# Default: true (needed for monitoring Phase 1)
LLM_LOG_ALL_VALIDATIONS=true

# ─────────────────────────────────────────────────────────────────────────
# EXAMPLE CONFIGURATIONS
# ─────────────────────────────────────────────────────────────────────────

# EXAMPLE 1: Phase 1 (Safe, Monitoring Only - Week 1)
# ────────────────────────────────────────────────
# LLM_ENABLED=true
# LLM_MONITORING_ENABLED=true
# LLM_MODIFIER_ENABLED=false
# LLM_MACRO_ENABLED=false
# LLM_WITH_SMC=true
# LLM_WITH_ML=true
#
# Description: Validates every signal asynchronously, caches patterns,
# tracks metrics. ZERO impact on trades. Decision gate at end: if
# validation accuracy > 60%, enable Phase 2.

# EXAMPLE 2: Phase 2 (Modifier Application - Week 2)
# ──────────────────────────────────────────────────
# LLM_ENABLED=true
# LLM_MONITORING_ENABLED=true
# LLM_MODIFIER_ENABLED=true
# LLM_MACRO_ENABLED=false
# LLM_MODIFIER_START_RATIO=0.10
#
# Description: Applies cached LLM modifiers to improve entry quality.
# Starts at 10% of signals, scales to 100% if effectiveness > 60%.
# Expected: Win rate improvement 55-60% → 60-65%.

# EXAMPLE 3: Phase 3 (Macro-Aware - Week 3)
# ──────────────────────────────────────────
# LLM_ENABLED=true
# LLM_MONITORING_ENABLED=true
# LLM_MODIFIER_ENABLED=true
# LLM_MACRO_ENABLED=true
#
# Description: Adds macro sentiment (Fed, news, events) to validation.
# Expected: Win rate improvement 60-65% → 65-70%+.
# Target: Stable profitability with reduced drawdown.

# EXAMPLE 4: Disabled (Fallback to SMC+ML)
# ─────────────────────────────────────────
# LLM_ENABLED=false
#
# Description: Disables all LLM validation. Falls back to pure SMC+ML.
# Use if LLM accuracy is poor or API unavailable.

# ─────────────────────────────────────────────────────────────────────────
# MONITORING & TROUBLESHOOTING
# ─────────────────────────────────────────────────────────────────────────

# Track these metrics in bot_status.json / logs:

# Phase 1 Success Metrics:
#   - signal_validation_rate: Should be 100% (all signals validated)
#   - cache_hit_rate: Should reach 40%+ after 50 signals
#   - validation_accuracy: Must exceed LLM_ACCURACY_THRESHOLD (60%)
#   - daily_api_cost: Should be <$0.01
#   - main_loop_latency: Should stay <50ms (zero LLM impact)

# Phase 2 Success Metrics:
#   - modifier_applied_ratio: Should be 10-100% (configurable)
#   - modifier_effectiveness: Must exceed LLM_EFFECTIVENESS_THRESHOLD (60%)
#   - win_rate_improvement: Target +3-5% from Phase 1
#   - confidence_calibration: Should be ±5% accurate

# Phase 3 Success Metrics:
#   - macro_sentiment_accuracy: Should improve signal quality
#   - macro_aligned_win_rate: Should be >70%
#   - cumulative_win_rate: Target 65-70%+
#   - profit_factor: Target >1.5

# ─────────────────────────────────────────────────────────────────────────
# ROLLBACK PROCEDURE (If metrics fail)
# ─────────────────────────────────────────────────────────────────────────

# Phase 1 rollback (back to SMC+ML only):
#   LLM_ENABLED=false
#   (Restart bot, zero risk, metrics reset immediately)

# Phase 2 rollback (back to monitoring-only):
#   LLM_MODIFIER_ENABLED=false
#   (Keeps monitoring, disables modifier application)

# Phase 3 rollback (back to Phase 2):
#   LLM_MACRO_ENABLED=false
#   (Keeps modifiers, removes macro sentiment)

# ─────────────────────────────────────────────────────────────────────────
# RECOMMENDED ROLLOUT SEQUENCE
# ─────────────────────────────────────────────────────────────────────────

# Week 1 (Jun 6-10): Phase 1 - Monitoring
# └─ Goal: Validation accuracy > 60%
# └─ If achieved: Proceed to Week 2

# Week 2 (Jun 13-17): Phase 2 - Modifiers (10% → 100%)
# └─ Goal: Modifier effectiveness > 60%
# └─ If achieved: Proceed to Week 3

# Week 3 (Jun 20-24): Phase 3 - Macro-Aware
# └─ Goal: Win rate 65-70%+, Profit factor >1.5
# └─ If achieved: Production deployment

# ─────────────────────────────────────────────────────────────────────────
